{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022"],
    "jsx": "react-jsx",
    "jsxImportSource": "ags/gtk4",
    "strict": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "paths": {
      "ags": ["/usr/share/ags/js/lib/index.ts"],
      "ags/*": ["/usr/share/ags/js/lib/*.ts"],
      "gnim": ["/usr/share/ags/js/node_modules/gnim/dist/index.ts"],
      "gnim/*": ["/usr/share/ags/js/node_modules/gnim/dist/*.ts"]
    }
  },
  "include": ["./**/*.ts", "./**/*.tsx"]
}
